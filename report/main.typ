            width: dims.width,
            height: slice-h,
            breakable: false,
            clip: true,
            stroke: 0.4pt + luma(210),
            inset: 0pt,
            place(
              top + left,
              dy: -i * slice-h,
              image(path, width: dims.width, height: dims.height),
            ),
          )
        }
      }
    },
  )
}

